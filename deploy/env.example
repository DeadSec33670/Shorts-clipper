# Скопировать в /etc/shorts-clipper.env и выставить права:
#     sudo chown root:clipper /etc/shorts-clipper.env
#     sudo chmod 640 /etc/shorts-clipper.env
# Файл содержит ключи от платных API — он не должен попадать в git и в бэкапы
# без шифрования.

# --- обязательное для публичного режима ---

# Включает защищённый режим: запрещает чтение файлов с диска сервера,
# отключает куки yt-dlp, требует HTTPS для cookie сессии.
CLIPPER_PUBLIC=1

# Ключ подписи сессий. Сгенерировать так:
#     python -c "import secrets; print(secrets.token_hex(32))"
# ВАЖНО: при смене ключа все пользователи разлогиниваются.
# Утечка ключа = возможность подделать любую сессию, включая админскую.
CLIPPER_SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ

# Первый администратор — создаётся один раз при первом запуске.
# После входа смените пароль и удалите эти две строки.
CLIPPER_ADMIN_EMAIL=admin@example.com
CLIPPER_ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ

# --- необязательное ---

# Максимальный размер загружаемого файла в гигабайтах.
# Должно совпадать с client_max_body_size в nginx.
CLIPPER_MAX_UPLOAD_GB=2

# --- ключи LLM-провайдеров ---
# Нужен только тот, который реально используется (--llm-provider).
# Несколько ключей одного провайдера включают ротацию при упоре в лимиты.

GOOGLE_API_KEY=
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEYS=ключ1,ключ2,ключ3

# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# --- Этап 2: база, хранилище, контакт ---

# По умолчанию SQLite в data/clipper.db — ничего ставить не нужно.
# Для PostgreSQL: pip install "psycopg[binary]" и раскомментировать строку.
# CLIPPER_DB_URL=postgresql://clipper:пароль@localhost/clipper

# Папка с данными пользователей (клипы, логи, загрузки).
# Выносите на отдельный большой диск.
CLIPPER_DATA_DIR=/opt/shorts-clipper/data

# Контакт администратора — показывается пользователям вместо оплаты.
CLIPPER_CONTACT=@ваш_телеграм

# --- Сроки хранения (автоочистка) ---
# Клипы. Главный расход диска. Пользователю стоит показывать дату удаления.
CLIPPER_KEEP_CLIPS_DAYS=30
CLIPPER_KEEP_LOGS_DAYS=14
CLIPPER_KEEP_UPLOADS_DAYS=2
CLIPPER_KEEP_WORK_DAYS=1
CLIPPER_KEEP_JOBS_DAYS=90
CLIPPER_KEEP_AUDIT_DAYS=365

# Аварийный порог: если свободного места меньше, самые старые клипы удаляются
# досрочно. Кончившийся диск останавливает сервис целиком.
CLIPPER_MIN_FREE_GB=20
CLIPPER_CLEANUP_INTERVAL=3600

# --- Кодировщик видео ---
# По умолчанию NVENC определяется автоматически, при отсутствии карты
# используется libx264. Принудительно: CLIPPER_ENCODER=libx264
# CLIPPER_ENCODER=libx264

# --- Резервное копирование ---
CLIPPER_BACKUP_DIR=/opt/shorts-clipper/backups
CLIPPER_BACKUP_KEEP=14
CLIPPER_BACKUP_INTERVAL=86400

# --- Уведомления на почту ---
# Если не заданы, письма просто не отправляются, обработка работает как обычно.
# Для Яндекса: smtp.yandex.ru:465 + CLIPPER_SMTP_SSL=1 и пароль приложения.
# Для Gmail: smtp.gmail.com:587 и пароль приложения (не основной пароль).
# CLIPPER_SMTP_HOST=smtp.yandex.ru
# CLIPPER_SMTP_PORT=465
# CLIPPER_SMTP_SSL=1
# CLIPPER_SMTP_USER=bot@ваш-домен.ru
# CLIPPER_SMTP_PASSWORD=пароль-приложения
# CLIPPER_SMTP_FROM=bot@ваш-домен.ru
# CLIPPER_SMTP_FROM_NAME=Shorts Clipper

# Адрес сайта — подставляется в письма ссылкой.
# CLIPPER_SITE_URL=https://ваш-домен.ru

# --- Хранилище клипов ---
# local (по умолчанию) — файлы на диске сервера.
# s3 — объектное хранилище. ОБЯЗАТЕЛЬНО, если воркеры будут подниматься
# и гаснуть на арендованных машинах: их диск исчезает вместе с инстансом.
# Требуется: pip install boto3
# CLIPPER_STORAGE=s3
# CLIPPER_S3_BUCKET=clips
# CLIPPER_S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
# CLIPPER_S3_REGION=ru-1
# CLIPPER_S3_KEY=идентификатор
# CLIPPER_S3_SECRET=секрет
# CLIPPER_S3_ADDRESSING=path        # для MinIO и части провайдеров
# CLIPPER_S3_URL_TTL=3600           # срок жизни подписанной ссылки, сек

# ВАЖНО: бакет должен быть ЗАКРЫТЫМ. Ссылки выдаются подписанные и недолгие.
# Открытый бакет = чужие видео с лицами и голосами доступны всем.

# --- Docker ---
# Модель распознавания, вшиваемая в образ воркера при сборке.
# Меньшая модель = меньше образ и быстрее старт, но хуже субтитры.
CLIPPER_WHISPER_MODEL=large-v3-turbo

# Пароль PostgreSQL — нужен только при профиле postgres.
# POSTGRES_PASSWORD=

# --- Доступ к YouTube ---
# Прокси для скачивания. Нужен, если YouTube недоступен напрямую
# (соединение обрывается по таймауту). Задаётся владельцем сервера и
# действует для всех пользователей.
# CLIPPER_PROXY=socks5://127.0.0.1:1080
# CLIPPER_PROXY=http://логин:пароль@хост:порт

# Таймаут соединения, сек (по умолчанию 60; у yt-dlp своё значение 20,
# которого не хватает при замедленном доступе).
# CLIPPER_SOCKET_TIMEOUT=120
# CLIPPER_DL_RETRIES=10

# Ожидание ответа от LLM, сек. Увеличьте, если запросы идут через медленный
# прокси и падают с таймаутом (по умолчанию 180).
# CLIPPER_LLM_TIMEOUT=300

# --- Автоматический прокси через API VPN (StealthSurf) ---
# Программа сама получит SOCKS5-прокси («дополнительный конфиг») и подставит
# его. Нужен, только если CLIPPER_PROXY не задан вручную.
# Ключ создаётся в консоли: https://console.stealthsurf.net
# CLIPPER_VPN_API_KEY=stlth_0123abcd_0123456789abcdef01234567
